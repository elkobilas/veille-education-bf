# Application de veille éducative — Burkina Faso
# Copiez ce fichier en .env et remplissez les valeurs

# Base de données
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Canal de notification
# Valeurs : "email" | "whatsapp" | "both"
# ---------------------------------------------------------------------------
NOTIFICATION_CHANNEL=email

# ---------------------------------------------------------------------------
# Option 1 : Notification par e-mail (Gmail)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASS=votre-mot-de-passe-dapplication
NOTIFICATION_EMAIL=kiemamahama@gmail.com

# ---------------------------------------------------------------------------
# Option 2 : Notification par WhatsApp
# Choisir UN seul fournisseur ci-dessous et laisser l'autre vide
# ---------------------------------------------------------------------------

# Fournisseur : "callmebot" (gratuit) ou "twilio" (payant)
WHATSAPP_PROVIDER=
WHATSAPP_PHONE=226XXXXXXXX

# Fournisseur A — CallMeBot (gratuit)
# 1. Ajouter +34 644 51 95 23 dans vos contacts WhatsApp
# 2. Envoyer ce message exact : I allow callmebot to send me messages
# 3. Copier la clé API reçue en réponse
WHATSAPP_CALLMEBOT_APIKEY=

# Fournisseur B — Twilio (officiel, ~0,005€/message)
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxx
# TWILIO_WHATSAPP_FROM=+14155238886

# ---------------------------------------------------------------------------
# OpenAI (pour les résumés automatiques — optionnel)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Fréquence de vérification en minutes (300 = toutes les 5 heures)
# ---------------------------------------------------------------------------
SCRAPE_INTERVAL_MINUTES=300

# URLs à surveiller (séparées par des virgules)
SCRAPE_URLS=https://www.mebapln.gov.bf,https://www.diospb.gov.bf
